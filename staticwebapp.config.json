{
  "platform": { "apiRuntime": "node:20" },
  "routes": [
    {
      "route": "/api/*",
      "allowedRoles": ["owner"]
    },
    {
      "route": "/*",
      "allowedRoles": ["owner"]
    }
  ],
  "responseOverrides": {
    "401": {
      "statusCode": 302,
      "redirect": "/.auth/login/aad"
    }
  }
}
